# Public source allowlist. Builds, Riot components, profiles and logs stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/Package.swift
!/build.sh
!/test.sh
!/build_arm64_host.py
!/launch_windows_live.py
!/launch-tft-live.sh
!/riot-sdk-host-override.json
!/app/
/app/*
!/app/build.py
!/Sources/
/Sources/**
!/Sources/TFTCore/
!/Sources/SDKHost/
!/Sources/TFTLiveCLI/
!/Sources/TFTLiveApp/
!/Sources/TFTCore/*.swift
!/Sources/SDKHost/*.swift
!/Sources/TFTLiveCLI/*.swift
!/Sources/TFTLiveApp/*.swift
!/Tests/
/Tests/**
!/Tests/TFTCoreTests/
!/Tests/TFTCoreTests/*.swift
